{
  "manifest_version": 3,

  "name": "Go SHP Client",
  "description": "Chrome Extension for a go lang secure HTTP proxy.",
  "version": "1.0.1",

  "options_page": "options.html",

  "action": {
    "default_icon": "icon_off.png",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "128": "icon.png"
  },

  "permissions": [
    "webRequestAuthProvider",
    "webRequest",
    "proxy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
