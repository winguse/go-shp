{
  "manifest_version": 3,

  "name": "Go SHP Client",
  "description": "Firefox Extension for a go lang secure HTTP proxy.",
  "version": "1.0.0",

  "options_page": "options.html",

  "action": {
    "default_icon": "icon_off.png",
    "default_popup": "popup.html"
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "incognito": "spanning",

  "browser_specific_settings": {
    "gecko": {
      "id": "go-shp@proxy.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "128": "icon.png"
  },

  "permissions": [
    "proxy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
